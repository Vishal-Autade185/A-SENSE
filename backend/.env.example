MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=asense
MQTT_PASSWORD=your_mosquitto_password_here

# Database Settings
ASENSE_DB_PATH=asense.db

# API Settings
PORT=8000
HOST=0.0.0.0

# Telegram Bot Settings (For proactive alerts & phone control)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
