[Unit]
Description=A-SENSE Autonomous Home Management Backend Service
After=network.target mosquitto.service ollama.service

[Service]
Type=simple
User=project
WorkingDirectory=/home/project/asense-backend
ExecStart=/home/project/asense-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/home/project/asense-backend/.env

# Standard output and error logging into system journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
